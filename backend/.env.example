PORT=5000
NODE_ENV=production

# Database connection URL (PostgreSQL):
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/seatlock
# For Neon/Supabase/Render Postgres: postgresql://user:pass@ep-xxx.neon.tech/seatlock?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/seatlock?sslmode=require

# JWT Secret for authentication (Generate a random 32+ character string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min

# Frontend URL for CORS whitelist (e.g. https://your-seatlock-app.vercel.app or comma-separated)
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# Seat lock timeout duration in minutes
HOLD_TIMEOUT_MINUTES=7

# Email Service (Gmail or Custom SMTP)
# Option A: Gmail Direct Service (uses Google App Password)
EMAIL_USER=your-cinema-email@gmail.com
EMAIL_PASS=your-16-char-google-app-password
EMAIL_FROM="SeatLock Cinema <your-cinema-email@gmail.com>"

# Option B: Custom SMTP (Optional, if using SendGrid/Mailgun/SES/Custom)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-smtp-password
